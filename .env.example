# Waymark backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://your-public-tunnel.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Local demo runs without third-party credentials. Disable this in a live pilot.
DEMO_MODE=true
DATABASE_PATH=./data/waymark.db
# Neon/PostgreSQL connection string. When set, this is the primary application store.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
GUIDANCE_CONFIDENCE_THRESHOLD=0.68
GROUNDING_RADIUS_METERS=2500
LANDMARK_FRESHNESS_HALF_LIFE_DAYS=180

# Infobip Calls API
# Bring: one or more voice-capable numbers, Calls Configuration ID, event subscription,
# and a MEDIA_STREAMING config targeting wss://your-host/v1/telephony/infobip/media.
TELEPHONY_PROVIDER=infobip
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://your-subdomain.api.infobip.com
INFOBIP_CALLS_CONFIGURATION_ID=
INFOBIP_MEDIA_STREAM_CONFIG_ID=
# Comma-separated E.164 numbers, for example +2342012345678,+2342098765432
INFOBIP_PROXY_NUMBERS=
# Configure these Basic credentials on the VOICE_VIDEO event subscription.
INFOBIP_WEBHOOK_USERNAME=
INFOBIP_WEBHOOK_PASSWORD=
# Configure these Basic credentials on the MEDIA_STREAMING configuration.
INFOBIP_MEDIA_STREAM_USERNAME=
INFOBIP_MEDIA_STREAM_PASSWORD=

# Optional Twilio fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PROXY_NUMBERS=
TWILIO_VALIDATE_SIGNATURES=true
CALL_DISCLOSURE=This call is processed by Waymark to provide live directions.

# Intron Sahara streaming STT
# Get the server-side key from https://voice.intron.io (Developers tab).
STT_PROVIDER=sahara
INTRON_API_KEY=
INTRON_STREAM_URL=wss://infer.voice.intron.io/stt/v1/stream
INTRON_FILE_URL=https://infer.voice.intron.io/file/v1/upload/sync
# pcm = Nigerian Pidgin-English; yo, ig, and ha are also code-switched models.
INTRON_LANGUAGE=pcm
INTRON_SAMPLE_RATE=16000

# Mapbox Search Box API plus Geocoding v6 fallback for Nigerian addresses and places.
# Restrict the token to the required search scopes and approved deployment URLs.
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
MAPBOX_SEARCH_URL=https://api.mapbox.com/search/searchbox/v1/forward
MAPBOX_GEOCODING_URL=https://api.mapbox.com/search/geocode/v6/forward

# Required only when running the three-model benchmark
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_MODEL=scribe_v2

# Optional observability / storage integrations
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
